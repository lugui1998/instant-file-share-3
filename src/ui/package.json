{
  "name": "instant-file-share-ui",
  "private": true,
  "version": "0.1.0",
  "productName": "Instant File Share",
  "description": "Windows desktop dashboard for Instant File Share.",
  "author": "Instant File Share",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "electron:dev": "concurrently -k \"npm:dev\" \"npm:electron:watch\" \"npm:electron:start\"",
    "electron:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "electron:start": "wait-on tcp:5173 file:dist-electron/electron/main.js && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vue-tsc --noEmit && vite build && node ./scripts/patch-dist-html.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package:win": "npm run build && electron-builder --win dir",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.1",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vue-tsc": "^2.2.10",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.instantfileshare.app",
    "productName": "Instant File Share",
    "directories": {
      "output": "../../artifacts/package/ui"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "dir"
      ]
    }
  }
}
