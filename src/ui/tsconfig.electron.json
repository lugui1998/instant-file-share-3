{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "shared/**/*.ts",
    "electron/**/*.ts"
  ],
  "exclude": [
    "electron/**/*.spec.ts",
    "shared/**/*.spec.ts"
  ]
}
